{
  "name": "codex-subagent",
  "displayName": "Codex Subagent",
  "description": "Persistent BYOK worker agents for Codex, using VS Code language models through MCP.",
  "version": "0.3.0",
  "publisher": "xisui-PA",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/xisui-PA/codex_subagent.git"
  },
  "license": "MIT",
  "homepage": "https://github.com/xisui-PA/codex_subagent#readme",
  "bugs": {
    "url": "https://github.com/xisui-PA/codex_subagent/issues"
  },
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codexSubagent.register",
        "title": "Register MCP with Codex",
        "category": "Codex Subagent",
        "icon": "$(plug)"
      },
      {
        "command": "codexSubagent.unregister",
        "title": "Unregister MCP from Codex",
        "category": "Codex Subagent",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "codexSubagent.enableModel",
        "title": "Enable Model",
        "category": "Codex Subagent",
        "icon": "$(add)"
      },
      {
        "command": "codexSubagent.disableModel",
        "title": "Disable Model",
        "category": "Codex Subagent",
        "icon": "$(remove)"
      },
      {
        "command": "codexSubagent.diagnostics",
        "title": "Show Diagnostics",
        "category": "Codex Subagent",
        "icon": "$(info)"
      },
      {
        "command": "codexSubagent.showLog",
        "title": "Show Log",
        "category": "Codex Subagent",
        "icon": "$(output)"
      },
      {
        "command": "codexSubagent.refresh",
        "title": "Refresh Workers",
        "category": "Codex Subagent",
        "icon": "$(refresh)"
      },
      {
        "command": "codexSubagent.openWorker",
        "title": "Open Worker Transcript",
        "category": "Codex Subagent",
        "icon": "$(open-preview)"
      },
      {
        "command": "codexSubagent.cancelWorker",
        "title": "Cancel Worker",
        "category": "Codex Subagent",
        "icon": "$(debug-stop)"
      },
      {
        "command": "codexSubagent.resumeWorker",
        "title": "Resume Worker",
        "category": "Codex Subagent",
        "icon": "$(play)"
      },
      {
        "command": "codexSubagent.deleteWorker",
        "title": "Delete Worker",
        "category": "Codex Subagent",
        "icon": "$(trash)"
      },
      {
        "command": "codexSubagent.setup",
        "title": "Set Up Workers",
        "category": "Codex Subagent",
        "icon": "$(wand)"
      },
      {
        "command": "codexSubagent.checkConnection",
        "title": "Check MCP Connection",
        "category": "Codex Subagent",
        "icon": "$(plug)"
      },
      {
        "command": "codexSubagent.retryHost",
        "title": "Retry Worker Host",
        "category": "Codex Subagent",
        "icon": "$(refresh)"
      },
      {
        "command": "codexSubagent.newWorker",
        "title": "New Worker",
        "category": "Codex Subagent",
        "icon": "$(add)"
      },
      {
        "command": "codexSubagent.sendMessage",
        "title": "Send Follow-up",
        "category": "Codex Subagent",
        "icon": "$(comment)"
      },
      {
        "command": "codexSubagent.compactWorker",
        "title": "Compact Worker",
        "category": "Codex Subagent",
        "icon": "$(archive)"
      },
      {
        "command": "codexSubagent.discardQueued",
        "title": "Discard Queued Messages",
        "category": "Codex Subagent",
        "icon": "$(clear-all)"
      },
      {
        "command": "codexSubagent.exportWorker",
        "title": "Export Transcript",
        "category": "Codex Subagent",
        "icon": "$(export)"
      },
      {
        "command": "codexSubagent.cleanupWorkers",
        "title": "Clean Up Saved Workers",
        "category": "Codex Subagent",
        "icon": "$(trash)"
      },
      {
        "command": "codexSubagent.savedWorkspaces",
        "title": "Browse Saved Workspaces",
        "category": "Codex Subagent",
        "icon": "$(folder-library)"
      },
      {
        "command": "codexSubagent.configureModel",
        "title": "Configure Model Options",
        "category": "Codex Subagent",
        "icon": "$(settings-gear)"
      },
      {
        "command": "codexSubagent.openModelSettings",
        "title": "Open Model Settings",
        "category": "Codex Subagent",
        "icon": "$(settings)"
      },
      {
        "command": "codexSubagent.revokeShellApproval",
        "title": "Revoke Shell Approval",
        "category": "Codex Subagent",
        "icon": "$(shield)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexSubagent",
          "title": "Codex Subagent",
          "icon": "media/container.svg"
        }
      ]
    },
    "views": {
      "codexSubagent": [
        {
          "id": "codexSubagent.workers",
          "name": "Codex Workers",
          "icon": "$(hubot)",
          "visibility": "visible"
        },
        {
          "id": "codexSubagent.models",
          "name": "Models",
          "icon": "$(brain)",
          "visibility": "visible"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "codexSubagent.workers",
        "contents": "Delegate work to your VS Code models.\n[Set up workers](command:codexSubagent.setup)\n[New worker](command:codexSubagent.newWorker)\n[Diagnostics](command:codexSubagent.diagnostics)\n[Retry host](command:codexSubagent.retryHost)",
        "when": "view == codexSubagent.workers"
      },
      {
        "view": "codexSubagent.models",
        "contents": "No worker models are enabled.\n[Enable Model](command:codexSubagent.enableModel)\n[Open User Settings](command:codexSubagent.openModelSettings)",
        "when": "view == codexSubagent.models && codexSubagent.modelsEmpty"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codexSubagent.newWorker",
          "when": "view == codexSubagent.workers",
          "group": "navigation"
        },
        {
          "command": "codexSubagent.refresh",
          "when": "view == codexSubagent.workers",
          "group": "navigation"
        },
        {
          "command": "codexSubagent.setup",
          "when": "view == codexSubagent.workers",
          "group": "navigation"
        },
        {
          "command": "codexSubagent.enableModel",
          "when": "view == codexSubagent.models",
          "group": "navigation"
        },
        {
          "command": "codexSubagent.configureModel",
          "when": "view == codexSubagent.models",
          "group": "navigation"
        },
        {
          "command": "codexSubagent.openModelSettings",
          "when": "view == codexSubagent.models",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "codexSubagent.cancelWorker",
          "when": "view == codexSubagent.workers && viewItem == workerRunning",
          "group": "inline"
        },
        {
          "command": "codexSubagent.resumeWorker",
          "when": "view == codexSubagent.workers && viewItem == workerResumable",
          "group": "inline"
        },
        {
          "command": "codexSubagent.sendMessage",
          "when": "view == codexSubagent.workers && viewItem == workerCompleted",
          "group": "inline"
        },
        {
          "command": "codexSubagent.sendMessage",
          "when": "view == codexSubagent.workers && viewItem == workerRunning",
          "group": "actions"
        },
        {
          "command": "codexSubagent.openWorker",
          "when": "view == codexSubagent.workers && viewItem == workerCompleted",
          "group": "actions"
        },
        {
          "command": "codexSubagent.exportWorker",
          "when": "view == codexSubagent.workers && viewItem == workerCompleted",
          "group": "actions"
        },
        {
          "command": "codexSubagent.compactWorker",
          "when": "view == codexSubagent.workers && viewItem == workerResumable",
          "group": "actions"
        },
        {
          "command": "codexSubagent.compactWorker",
          "when": "view == codexSubagent.workers && viewItem == workerCompleted",
          "group": "actions"
        },
        {
          "command": "codexSubagent.discardQueued",
          "when": "view == codexSubagent.workers && viewItem == workerResumable",
          "group": "actions"
        },
        {
          "command": "codexSubagent.discardQueued",
          "when": "view == codexSubagent.workers && viewItem == workerRunning",
          "group": "actions"
        },
        {
          "command": "codexSubagent.deleteWorker",
          "when": "view == codexSubagent.workers && viewItem == workerCompleted",
          "group": "actions"
        },
        {
          "command": "codexSubagent.deleteWorker",
          "when": "view == codexSubagent.workers && viewItem == workerResumable",
          "group": "actions"
        },
        {
          "command": "codexSubagent.configureModel",
          "when": "view == codexSubagent.models && viewItem == modelEntry",
          "group": "actions"
        },
        {
          "command": "codexSubagent.openModelSettings",
          "when": "view == codexSubagent.models",
          "group": "actions"
        }
      ]
    },
    "configuration": {
      "title": "Codex Subagent",
      "properties": {
        "codexSubagent.models": {
          "type": "object",
          "default": {},
          "scope": "machine",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "allowWrite": {
                "type": "boolean",
                "default": true,
                "description": "Per-model write policy: omitted or true allows workspace-write workers for this model; false restricts all workspace edits and change tools."
              },
              "allowShell": {
                "type": "boolean",
                "default": true,
                "description": "Per-model shell policy: omitted or true may offer shell to this model's workspace-write workers; false restricts it. Shell still requires workspace-write and user approval."
              },
              "numSessions": {
                "type": "integer",
                "default": 1,
                "minimum": 1,
                "maximum": 8,
                "description": "Maximum simultaneously active conversations for this model in the owning workspace store. Built-in default when omitted: 1."
              },
              "maxToolRounds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 200,
                "description": "Per-model tool rounds per turn before manual resumption is required. Built-in default when omitted: 40."
              },
              "turnTimeoutSeconds": {
                "type": "integer",
                "minimum": 10,
                "maximum": 3600,
                "description": "Per-model deadline per turn, including tool execution. Built-in default when omitted: 600."
              },
              "autoCompact": {
                "type": "boolean",
                "description": "Per-model automatic summarization before limits. Built-in default when omitted: true."
              },
              "modelOptions": {
                "type": "object",
                "default": {},
                "additionalProperties": true,
                "description": "Provider-specific request options passed to VS Code sendRequest for this exact model, such as supported reasoning options. Arbitrary provider JSON is allowed; never put credentials here. Omitted means no extra options."
              }
            }
          },
          "description": "The sole enabled-model source: each key is an exact VS Code model ID that is enabled for workers, and the value is that model's policy. Entry order is the automatic-selection priority. Enabling a model through 'Codex Subagent: Enable Model' adds its exact ID here (User settings only); disabling removes it. Manual User Settings edits take effect immediately. Workspace settings never enable or expand models. An explicit subagent_spawn model must match a key exactly (no name/vendor aliases). An empty object means no models are enabled: workers, tools and inference are unavailable until at least one model is enabled. This pool is the sole permission and limit configuration source; omitted numSessions/maxToolRounds/turnTimeoutSeconds/autoCompact use built-in defaults 1/40/600/true."
        },
        "codexSubagent.notifyOnCompletion": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "Notify when an observed worker finishes or fails."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist",
    "test": "npm run build && npm run build:test && node --test \"tests/*.test.cjs\"",
    "build:test": "tsc -p tsconfig.json --outDir .test-build --sourceMap false",
    "vsix": "vsce package",
    "test:host": "npm run build && npm run build:test && node tests/run-host-tests.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.x",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^4.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^65.3.11",
    "globals": "^17.13.0",
    "ts-loader": "^9.6.2",
    "typescript": "^5.x",
    "typescript-eslint": "^8.71.2",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "smol-toml": "^1.9.1",
    "zod": "^4.6.7"
  },
  "keywords": [
    "codex",
    "mcp",
    "subagent",
    "byok",
    "local-llm"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Diagnostics and model setup are available; worker execution requires a trusted filesystem workspace."
    },
    "virtualWorkspaces": {
      "supported": false
    }
  }
}
